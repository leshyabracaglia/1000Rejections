# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Supabase CLI local state (project ref, cached version info, pooler URL --
# regenerated by `supabase link`). Migrations in supabase/migrations/ are
# NOT covered by this and should stay tracked.
supabase/.temp/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# build artifacts
*.ipa
*.apk
*.aab

# test coverage
coverage/

# Ruby / Bundler (Fastlane)
vendor/
.bundle/
Gemfile.lock

# Fastlane generated
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/README.md

# generated native folders
/ios/Pods/
/ios/build/
/android

# Xcode build artifacts
.build/

# Stale fastlane test copy (canonical is ios/ScreenshotUITests/)
fastlane/ScreenshotUITests/
