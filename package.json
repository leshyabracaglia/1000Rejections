{
  "name": "1000rejections",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "maestro test .maestro/flows/",
    "test:e2e:smoke": "maestro test .maestro/flows/smoke.yaml",
    "screenshots": "fastlane screenshots"
  },
  "dependencies": {
    "@expo-google-fonts/inconsolata": "^0.4.2",
    "@expo-google-fonts/lato": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.93.3",
    "babel-preset-expo": "^54.0.10",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-constants": "^18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nern-)?(modules-)?|@expo(nern-)?/|@supabase/|react-native-url-polyfill|base64-arraybuffer|react-native-svg|react-native-reanimated|react-native-gesture-handler|react-native-chart-kit)"
    ]
  }
}
